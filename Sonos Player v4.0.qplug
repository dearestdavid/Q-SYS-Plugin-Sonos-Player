  Shuffle      = {pg=1, ct="Button", bt="Toggle",  up=true, ps="Both", nc=Colors.Accent, oc=Colors.Idle, px=86, py=390, sx=32, sy=32, r=32, m=4, p=3, ict="Icon", ic="Shuffle"},
