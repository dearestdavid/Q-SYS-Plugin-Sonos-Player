  Discover_IP    = {pg=2, ct="Text", bt="Text Box", up=false, nc=Colors.Field, oc=Colors.Field, px=96, py=100, sx=208, sy=24, r=3, m=2, fs=10},
  Discover       = {pg=2, ct="Button", bt="Trigger", l="Discover", up=true, ps="Input", nc=Colors.Green, oc=Colors.Button, px=12, py=130, sx=292, sy=28, r=4, m=3, fs=11},
  Command        = {pg=2, ct="Text", bt="Text Box", up=true, ps="Both", nc=Colors.Field, oc=Colors.Field, px=96, py=198, sx=208, sy=24, r=3, m=2, fs=10},
  Command_Result = {pg=2, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Field, oc=Colors.Field, px=96, py=228, sx=208, sy=24, r=3, m=2, fs=10},
  Play_URI       = {pg=2, ct="Text", bt="Text Box", up=true, ps="Both", nc=Colors.Field, oc=Colors.Field, px=96, py=258, sx=208, sy=24, r=3, m=2, fs=10},
  Max_Volume     = {pg=2, ct="Knob", cu="Integer", Min=0, Max=100, st="Text Field", up=true, ps="Both", nc=Colors.Field, oc=Colors.Field, px=96, py=288, sx=60, sy=24, r=3, m=2, fs=10},
  Snapshot       = {pg=2, ct="Button", bt="Trigger", l="Snapshot", up=true, ps="Both", nc=Colors.Green, oc=Colors.Button, px=12, py=322, sx=142, sy=28, r=4, m=3, fs=11},
  Restore        = {pg=2, ct="Button", bt="Trigger", l="Restore", up=true, ps="Both", nc=Colors.Green, oc=Colors.Button, px=162, py=322, sx=142, sy=28, r=4, m=3, fs=11},
