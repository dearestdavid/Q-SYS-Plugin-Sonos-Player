  Online       = {pg=1, ct="Indicator", it="Led", st="Led", up=true, ps="Output", nc=Colors.Green, oc=Colors.Idle, px=12, py=12, sx=12, sy=12},
  Art          = {pg=1, ct="Button", bt="Trigger", up=false, nc=Colors.Page, oc=Colors.Page, px=58, py=12, sx=200, sy=200, r=6, m=0},
  Room         = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Page, oc=Colors.Page, px=12, py=220, sx=200, sy=24, fs=13},
  State        = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Field, oc=Colors.Field, px=216, py=220, sx=88, sy=24, fs=8, r=3},
  Track        = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Page, oc=Colors.Page, px=12, py=248, sx=292, sy=22, fs=11},
  Artist       = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Page, oc=Colors.Page, px=12, py=272, sx=292, sy=18, fs=9},
  Album        = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Page, oc=Colors.Page, px=12, py=292, sx=292, sy=18, fs=9},
  Elapsed      = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Page, oc=Colors.Page, px=12, py=318, sx=40, sy=14, fs=8},
  Time         = {pg=1, ct="Knob", cu="Percent", Min=0, Max=100, st="Fader", up=true, ps="Both", nc=Colors.Accent, oc=Colors.Accent, px=56, py=318, sx=204, sy=14, r=3, m=0},
  Duration     = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Page, oc=Colors.Page, px=264, py=318, sx=40, sy=14, fs=8},
  Previous     = {pg=1, ct="Button", bt="Trigger", up=true, ps="Both", nc=Colors.Accent, oc=Colors.Idle, px=78, py=342, sx=40, sy=40, r=40, m=5, p=3, ict="Icon", ic="Previous"},
  Play         = {pg=1, ct="Button", bt="Toggle",  up=true, ps="Both", nc=Colors.Accent, oc=Colors.Idle, px=138, py=342, sx=40, sy=40, r=8, m=5, p=3, ict="Icon", ic="Play Pause"},
