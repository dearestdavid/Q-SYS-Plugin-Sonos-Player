--------------------------------------------------------------------------------
-- Sonos Player  -  one plugin instance per Sonos player
-- David - Threshold Audio  (threshold.audio)
--
-- Talks UPnP/SOAP directly to the player (port 1400), no cloud.
-- Property "Player" is a room name (e.g. "Kitchen") or an IP address.
-- Transport commands are always sent to the coordinator of the player's group,
-- volume/mute to the player itself, so the instance behaves correctly when the
-- player is a member of a group.
--------------------------------------------------------------------------------

PluginInfo = {
	Name = "Threshold Audio~Sonos Player",
	Version = "4.0",
	Id = "076e44d3-69ba-4ece-8156-64387db20b87",
	Description = "One Sonos player per plugin instance (UPnP/SOAP, no cloud). Transport, volume, shuffle/repeat, seek, grouping, favorites, Play URI, Snapshot/Restore, command pin. By David - Threshold Audio.",
	ShowDebug = true,
	Author = "David - Threshold Audio"
}

function GetPrettyName(props)
	local p = props["Player"].Value
	if p ~= nil and p ~= "" then return "Sonos: "..p end
	return "Sonos Player"
end

function GetColor(props)
	return {25, 25, 25}
end

function GetProperties()
    local props = {}
    table.insert(props, { Name = "Player",    Type = "string", Value = "" })
    table.insert(props, { Name = "Artwork",   Type = "enum",   Choices = {"On", "Off"},       Value = "On" })
    table.insert(props, { Name = "Poll Rate", Type = "enum",   Choices = {"1 s", "2 s", "5 s"}, Value = "2 s" })
	return props
end

Colors = {
    Accent = {11, 167, 195},
    Idle   = {96, 96, 96},
    MuteOn = {200, 40, 40},
    Green  = {30, 140, 60},
    Red    = {200, 40, 40},
    Page   = {24, 24, 24},
    Field  = {54, 54, 54},
    Button = {64, 64, 64},
    White  = {255, 255, 255},
    Text   = {235, 235, 235},
    Dim    = {150, 150, 150},
}

-- pg = page, st = layout style override (defaults to ct), tbs = TextBoxStyle, hide = pins only
ControlsTable = {
