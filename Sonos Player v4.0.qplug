  Favorite     = {pg=1, ct="Text", tbs="ComboBox", st="ComboBox", up=true, ps="Both", nc=Colors.Field, oc=Colors.Field, px=92, py=530, sx=212, sy=24, r=3, m=2, fs=10},
  Coordinator  = {pg=1, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Page, oc=Colors.Page, px=12, py=560, sx=292, sy=16, fs=8},
  ---------------------------------------------------------------- page 2 : Setup
  IP             = {pg=2, ct="Indicator", it="Text", up=true, ps="Output", nc=Colors.Field, oc=Colors.Field, px=96, py=40, sx=208, sy=24, r=3, m=2, fs=10},
